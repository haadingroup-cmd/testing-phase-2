# ──────────────────────────────────────────────────────────────────────────
# HaadinGlobal — environment variables
# Copy to `.env` for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.
# ──────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required for forms, admin and audit).
# Neon / Supabase / Vercel Postgres / Railway all work. Use the pooled URL
# on Vercel and add ?sslmode=require when your provider needs SSL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/haadinglobal?schema=public"

# Secret used to sign admin session cookies. 32+ random characters.
# Generate: openssl rand -base64 48
AUTH_SECRET=""

# First admin account — used by `npm run db:seed` / `npm run admin:create`.
# Remove ADMIN_PASSWORD from your environment after the admin is created.
ADMIN_EMAIL="haadinglobal@gmail.com"
ADMIN_PASSWORD=""

# Email notifications for new leads via Resend (optional).
# Without these the site still works; leads are saved in the database.
RESEND_API_KEY=""
EMAIL_FROM="HaadinGlobal Website <notifications@haadinglobal.com>"
EMAIL_TO="haadinglobal@gmail.com"

# Public site settings.
NEXT_PUBLIC_SITE_URL="https://www.haadinglobal.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="923054782677"

# Optional: Google PageSpeed Insights API key — adds Lighthouse/Core Web
# Vitals lab data to the website audit. https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=""

# Optional: Google Search Console verification token (meta tag content).
GOOGLE_SITE_VERIFICATION=""
