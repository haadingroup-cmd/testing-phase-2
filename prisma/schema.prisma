// HaadinGlobal — database schema (PostgreSQL)
// Run `npm run db:migrate` locally or `npm run db:deploy` in production.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Admin users ────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(ADMIN)
  // Bumped on password change / "log out everywhere" to invalidate sessions.
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum Role {
  ADMIN
  EDITOR
}

// ─── Leads (contact, consultation, package builder, pricing, audit) ────────

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String
  business  String?
  website   String?
  service   String?
  budget    String?
  message   String?
  source    LeadSource @default(CONTACT)
  status    LeadStatus @default(NEW)
  // Structured payload for package-builder requests (services, stage, horizon, totals).
  details   Json?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  auditRequests AuditRequest[]

  @@index([status])
  @@index([createdAt])
  @@index([service])
  @@index([source])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  CONTACT
  CONSULTATION
  PACKAGE_BUILDER
  AUDIT
}

// ─── Services ───────────────────────────────────────────────────────────────

model Service {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  tagline          String
  category         ServiceCategory
  icon             String
  shortDescription String
  description      String
  price            Int
  priceUnit        PriceUnit       @default(MONTH)
  highlights       String[]
  features         String[]
  benefits         String[]
  // [{ title, description }]
  process          Json
  // [{ question, answer }]
  faqs             Json
  ctaLabel         String
  whatsappMessage  String?
  seoTitle         String?
  seoDescription   String?
  image            String?
  featured         Boolean         @default(false)
  inBuilder        Boolean         @default(true)
  builderLabel     String?
  sortOrder        Int             @default(0)
  published        Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([published, sortOrder])
  @@index([category])
}

enum ServiceCategory {
  PERFORMANCE
  TECH
  CREATIVE
}

enum PriceUnit {
  MONTH
  PROJECT
}

// ─── Pricing plans ──────────────────────────────────────────────────────────

model PricingPlan {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  eyebrow         String
  description     String
  price           Int
  billingPeriod   String      @default("month")
  // Percent discount applied when the visitor switches to "Project" billing.
  projectDiscount Int         @default(10)
  features        String[]
  serviceLimits   String?
  popular         Boolean     @default(false)
  variant         PlanVariant @default(STANDARD)
  ctaLabel        String
  whatsappMessage String?
  sortOrder       Int         @default(0)
  published       Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([published, sortOrder])
}

enum PlanVariant {
  STANDARD
  POPULAR
  PREMIUM
}

// ─── Blog ───────────────────────────────────────────────────────────────────

model BlogPost {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String
  // Sanitised HTML.
  content        String
  coverImage     String?
  category       String
  tags           String[]
  author         String     @default("HaadinGlobal Team")
  readTime       String?
  status         PostStatus @default(DRAFT)
  featured       Boolean    @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// ─── Case studies ───────────────────────────────────────────────────────────

model CaseStudy {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  client        String
  industry      String
  country       String
  service       String
  // Filter tags: meta, google, seo, ecommerce, gulf, web, ai …
  tags          String[]
  problem       String
  strategy      String
  result        String
  headlineValue String?
  headlineLabel String?
  // [{ label, value }]
  metrics       Json
  // { before, after } — free text, optional
  beforeAfter   Json?
  coverImage    String?
  // [{ src, caption }]
  gallery       Json
  liveUrl       String?
  // True while content is a placeholder waiting for verified client data.
  isPlaceholder Boolean  @default(false)
  published     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}

// ─── FAQ ────────────────────────────────────────────────────────────────────

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  // "general" or a service slug.
  category  String   @default("general")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, published, sortOrder])
}

// ─── Site settings (single JSON document per key) ──────────────────────────

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── SEO audit requests ─────────────────────────────────────────────────────

model AuditRequest {
  id        String      @id @default(cuid())
  url       String
  finalUrl  String?
  phone     String?
  email     String?
  sector    String?
  status    AuditStatus @default(PENDING)
  score     Int?
  // Full structured report (see src/lib/audit/types.ts).
  report    Json?
  error     String?
  leadId    String?
  lead      Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([createdAt])
  @@index([status])
}

enum AuditStatus {
  PENDING
  COMPLETED
  FAILED
}

// ─── Rate limiting (serverless-safe, shared across instances) ──────────────

model RateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime

  @@index([resetAt])
}
